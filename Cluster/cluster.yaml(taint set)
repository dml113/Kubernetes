apiVersion: eksctl.io/v1alpha5
kind: ClusterConfig

metadata:
  name: lee-eks-cluster
  version: "1.29"
  region: ap-northeast-2

vpc:
  subnets:
    public:
      public-a: { id: <PUBLIC_SUBNET_A_ID> }
      public-b: { id: <PUBLIC_SUBNET_B_ID> }
    private:
      private-a: { id: <PRIVATE_SUBNET_A_ID> }
      private-b: { id: <PRIVATE_SUBNET_B_ID> }

iamIdentityMappings:
  - arn: arn:aws:iam::<ACCOUNT_ID>:role/root
    groups:
      - system:masters
    username: root-admin
    noDuplicateARNs: true # prevents shadowing of ARNs

iam:
  withOIDC: true
  serviceAccounts:
  - metadata:
      name: aws-load-balancer-controller
      namespace: kube-system
    wellKnownPolicies:
      awsLoadBalancerController: true

managedNodeGroups:
  - name: lee-app-ng
    labels: { app: nga }
    instanceType: t3.medium
    instanceName: lee-app-node
    desiredCapacity: 2
    minSize: 2
    maxSize: 20
    privateNetworking: true
    volumeType: gp2
    volumeEncrypted: true
    iam:
      withAddonPolicies:
        imageBuilder: true
        awsLoadBalancerController: true
        autoScaler: true
    taints:
      - key: "app-tier"
        value: "frontend"
        effect: "NoSchedule"

  # Addon node group
  - name: lee-addon-ng
    labels: { role: addon }
    instanceType: t3.medium
    instanceName: lee-addon-node
    desiredCapacity: 2
    minSize: 2
    maxSize: 10
    privateNetworking: true
    volumeType: gp2
    volumeEncrypted: true

    iam:
      withAddonPolicies:
        imageBuilder: true
        awsLoadBalancerController: true
        autoScaler: true
