apiVersion: eksctl.io/v1alpha5
kind: ClusterConfig

metadata:
  name: lee-eks-cluster
  version: "1.29"
  region: ap-northeast-2

vpc:
  subnets:
    public:
      public-a: { id: subnet-09040fe9b286783bc }
      public-b: { id: subnet-0a6e29964f75ce767 }
    private:
      private-a: { id: subnet-026207dbcb547148d }
      private-b: { id: subnet-0d697f8494136723d }

iamIdentityMappings:
  - arn: arn:aws:iam::211125622661:user/student2 # kubectl edit configmap aws-auth -n kube-system
    groups:                                  # edit to arn:aws:iam::950274644703:role/root -> arn:aws:iam::950274644703:root  
      - system:masters
    username: root-admin
    noDuplicateARNs: true # prevents shadowing of ARNs

iam:
  withOIDC: true
  serviceAccounts:
  - metadata:
      name: aws-load-balancer-controller
      namespace: kube-system
    wellKnownPolicies:
      awsLoadBalancerController: true

managedNodeGroups:
  - name: lee-app-ng
    labels: { app: nga }
    instanceType: t3.medium
    instanceName: lee-app-node
    desiredCapacity: 2
    minSize: 2
    maxSize: 20
    privateNetworking: true
    volumeType: gp2
    volumeEncrypted: true
    iam:
      withAddonPolicies:
        imageBuilder: true
        awsLoadBalancerController: true
        autoScaler: true
    taints:
      - key: "app-tier"
        value: "frontend"
        effect: "NoSchedule"

  # Addon node group
  - name: lee-addon-ng
    labels: { role: addon }
    instanceType: t3.medium
    instanceName: lee-addon-node
    desiredCapacity: 2
    minSize: 2
    maxSize: 10
    privateNetworking: true
    volumeType: gp2
    volumeEncrypted: true
    taints:
      - key: "addon"
        value: "true"
        effect: "NoSchedule"
    iam:
      withAddonPolicies:
        imageBuilder: true
        awsLoadBalancerController: true
        autoScaler: true
