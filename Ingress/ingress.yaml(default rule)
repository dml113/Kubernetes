apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: skills-ingress
  namespace: skills
  annotations:
    kubernetes.io/ingress.class: alb
    alb.ingress.kubernetes.io/scheme: internet-facing
    alb.ingress.kubernetes.io/target-type: ip
    alb.ingress.kubernetes.io/wafv2-acl-arn: <waf arn>
spec:
  defaultBackend:
    service:
      name: frontend-svc
      port:
        number: 80
  rules:
    - http:
        paths:
          - path: /healthcheck
            pathType: Prefix
            backend:
              service:
                name: backend-svc
                port:
                  number: 8080
